# Copy to .env and fill in. .env is gitignored — never commit it.
# (Flare's own fce-sign repo commits a live testnet key. We don't.)

# ── Flare / Coston2 ────────────────────────────────────────────────────────
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
CHAIN_ID=114
DEPLOYER_PRIVATE_KEY=          # from `cast wallet new`, no 0x prefix
INITIAL_OWNER=                 # address derived from the above

# ── XRPL testnet ───────────────────────────────────────────────────────────
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234
XRPL_SEED=                     # family seed (s...) — NEVER commit or paste anywhere
XRPL_ADDRESS=

# ── Deployed by us (filled in by scripts/deploy) ───────────────────────────
COUNTER_ADDRESS=
MOCK_VAULT_ADDRESS=
INSTRUCTION_REGISTRY_ADDRESS=

# ── Xaman (XUMM) — backend only, never ship the secret to a browser ────────
# Free from https://apps.xumm.dev (sign in with GitHub). The secret is shown once.
XAMAN_API_KEY=
XAMAN_API_SECRET=
